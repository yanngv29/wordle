# Port de l'application
PORT=3000

# Configuration de la base de données
# Laissez vide ou commentez MONGODB_URI pour utiliser la base SQLite locale par défaut (wordle.db).
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB_NAME=wordle

# Configuration de Discord Bot / Activity
# Client ID de l'application Discord
DISCORD_CLIENT_ID=votre_client_id
# Client Secret de l'application Discord
DISCORD_CLIENT_SECRET=votre_client_secret
# Clé publique (Public Key) pour le webhook du Bot
DISCORD_PUBLIC_KEY=votre_public_key

# Configuration AWS S3 (pour le stockage des avatars)
# Région AWS
AWS_REGION=eu-west-3
# Nom du bucket S3 (doit être créé manuellement)
AWS_S3_BUCKET=wordle-avatars
# Clé d'accès AWS (ou utiliser IAM role)
AWS_ACCESS_KEY_ID=
# Secret AWS (ou utiliser IAM role)
AWS_SECRET_ACCESS_KEY=
# Dossier S3 pour les avatars
S3_AVATAR_FOLDER=avatars/

# Configuration des avatars
# Taille max du fichier avant upload (MB)
AVATAR_MAX_SIZE_MB=5
# Cache-Control max-age en secondes (1 année = 31536000)
AVATAR_CACHE_MAX_AGE=31536000
