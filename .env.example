# Port de l'application
PORT=3000

# Configuration de la base de données
# Laissez vide ou commentez MONGODB_URI pour utiliser la base SQLite locale par défaut (wordle.db).
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB_NAME=wordle

# Configuration de Discord Bot / Activity
# Client ID de l'application Discord
DISCORD_CLIENT_ID=votre_client_id
# Client Secret de l'application Discord
DISCORD_CLIENT_SECRET=votre_client_secret
# Clé publique (Public Key) pour le webhook du Bot
DISCORD_PUBLIC_KEY=votre_public_key
